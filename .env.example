# Copy to .env and fill in. .env is gitignored; .env.example is committed.

# Supabase Postgres connection string (BRIEF §5: Supabase, eu-central-1).
# DATABASE_URL → the running app. Use the transaction-mode pooler
# (pgbouncer, port 6543) for serverless / short-lived connections.
# DIRECT_URL  → drizzle-kit push / migrate / studio. MUST be the
# session-mode pooler (port 5432) or a direct connection. Drizzle-kit
# fans out parallel introspection queries; pgbouncer transaction mode
# muxes them across backend connections and corrupts the responses,
# which surfaces as a bogus "Cannot read properties of undefined
# (reading 'replace')" in the CHECK-constraint path. If DIRECT_URL is
# unset, drizzle.config falls back to DATABASE_URL.
# Example: postgresql://postgres.[REF]:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
DIRECT_URL=

# Sentry — error monitoring (BRIEF §5). Leave empty in development; the
# SDK is initialised but never opens a transport when these are unset.
# `SENTRY_DSN` is server-side, `NEXT_PUBLIC_*` is exposed to the browser.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Supabase Auth (BRIEF §5: phone OTP primary, email secondary). Both are
# safe to expose to the browser — the anon key is a public RLS-bound
# identifier, not a secret. Leave empty in development to use the
# cookie-backed stub session (any +966 phone, any 6-digit OTP). When
# both are set the sign-in flow switches to real SMS OTP — no code change.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated E.164 phones that can access /admin. Server-only.
# Example: ADMIN_PHONES=+966512345678,+966599999999
# Empty → /admin returns 404 for everyone.
ADMIN_PHONES=

# ─────────────────────────────────────────────────────────────────────
# Everything below was missing until 2026-07-28 (sixth audit). A fresh
# environment provisioned from the old file came up with payments off,
# no email, an inert cron, and — worst — PII encryption silently
# degraded to a PASS-THROUGH NO-OP, writing host IBANs and national IDs
# as plaintext. Every var below is optional-by-design in lib/env.ts, so
# absence never fails the boot; it just turns the feature off quietly.
# ─────────────────────────────────────────────────────────────────────

# Canonical public origin. Unset → the 3DS return URL is derived from
# request headers, which is host-header-poisonable. Set it in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AES-256-GCM key (base64, 32 bytes) for host identity PII at rest —
# IBANs, national IDs, CR numbers. `openssl rand -base64 32`.
# EMPTY = NO ENCRYPTION AT ALL (silent pass-through). Back the key up:
# losing it makes existing encrypted rows permanently unreadable.
PII_ENCRYPTION_KEY=

# Supabase service role — SERVER ONLY, bypasses RLS. Storage writes
# inside ownership-checked server actions. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret for signed cookies: the last-booking capability and the
# admin second-factor session marker. OPTIONAL — when empty the key is
# derived from SUPABASE_SERVICE_ROLE_KEY, which is always set in
# production. Set it only to rotate cookie signing independently of the
# service key. Rotating either invalidates outstanding cookies: guests
# re-verify by signing in, admins re-enter a 6-digit code.
COOKIE_SIGNING_SECRET=

# HyperPay / OPPWA (COPYandPAY). Empty access token or entity id →
# hasHyperpay() is false and the whole booking flow stays
# request-to-book with no card taken.
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_ENTITY_ID=
HYPERPAY_APPLEPAY_ENTITY_ID=
HYPERPAY_MODE=test
HYPERPAY_BASE_URL=
HYPERPAY_TEST_CONNECTOR=external
# Shared secret for the OPPWA webhook (the route IS built —
# app/api/webhooks/hyperpay). Empty → it answers 503 and settlement
# leans on /pay/return plus the cron reconcile.
HYPERPAY_WEBHOOK_SECRET=

# Resend transactional email. Both required before anything sends.
# RESEND_FROM is the sender guests see — always the brand display name
# over the brand mailbox, e.g.: Gharmish <hello@gharmish.com>
RESEND_API_KEY=
RESEND_FROM=
# Svix signing secret for delivery-status callbacks (optional).
RESEND_WEBHOOK_SECRET=

# Twilio WhatsApp. All three required for the channel to activate;
# per-template availability is gated by the Content SID map.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SIDS=

# Operational alerts inbox (refunds owed, settle anomalies, cron fail).
# Empty → notifyAdmin() is a silent no-op.
ADMIN_ALERT_EMAIL=
# Second alert rail: E.164 phone that mirrors every admin alert over
# WhatsApp (email alone rides Resend — the vendor whose outage is itself
# one of the alerts). Needs a Meta-approved `admin_alert` Content
# template SID in TWILIO_WHATSAPP_CONTENT_SIDS. Empty → email only.
ADMIN_ALERT_WHATSAPP=

# Guest-support WhatsApp number (E.164) published as a wa.me link on
# post-booking pages. Empty → falls back to TWILIO_WHATSAPP_FROM (guests
# already have that thread; inbound lands in the Twilio console). With
# neither set, no support link renders.
SUPPORT_WHATSAPP=

# WhatsApp support agent (Claude). Empty = new conversations go straight to
# the human inbox at /admin/support. Set to switch the first-line agent on.
ANTHROPIC_API_KEY=
# SUPPORT_AGENT_MODEL=claude-opus-4-8

# Bearer secret for the scheduled cron. EMPTY = the route rejects EVERY
# caller with 401 and no alert fires, so holds, reminders and wallet
# expiry all silently stop.
CRON_SECRET=

# Snap / TikTok pixels + Google Analytics 4 measurement id (G-XXXXXXXXXX).
# All consent-gated behind "Accept all"; empty → no marketing/analytics cookies.
NEXT_PUBLIC_SNAP_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# TikTok Events API access token (Events Manager → the pixel above →
# Settings → Generate Access Token). Server-only secret. When set, a
# server-side CompletePayment fires at payment settlement with the same
# event_id as the client pixel (`purchase:<ref>`), so TikTok dedupes
# them and ad-blocked/closed-tab conversions are still counted. Empty →
# client pixel only.
TIKTOK_EVENTS_ACCESS_TOKEN=

# GA4 Measurement Protocol API secret (GA4 Admin → Data streams → the
# web stream for NEXT_PUBLIC_GA_MEASUREMENT_ID → Measurement Protocol
# API secrets → Create). Server-only secret. When set, admin refunds
# send a GA4 `refund` event keyed to the purchase's transaction_id so
# revenue reports net out returned money. Empty → refunds unreported.
GA4_API_SECRET=
