# Copy to .env and fill in. .env is gitignored; .env.example is committed.

# Supabase Postgres connection string (BRIEF §5: Supabase, eu-central-1).
# DATABASE_URL → the running app. Use the transaction-mode pooler
# (pgbouncer, port 6543) for serverless / short-lived connections.
# DIRECT_URL  → drizzle-kit push / migrate / studio. MUST be the
# session-mode pooler (port 5432) or a direct connection. Drizzle-kit
# fans out parallel introspection queries; pgbouncer transaction mode
# muxes them across backend connections and corrupts the responses,
# which surfaces as a bogus "Cannot read properties of undefined
# (reading 'replace')" in the CHECK-constraint path. If DIRECT_URL is
# unset, drizzle.config falls back to DATABASE_URL.
# Example: postgresql://postgres.[REF]:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
DIRECT_URL=

# Sentry — error monitoring (BRIEF §5). Leave empty in development; the
# SDK is initialised but never opens a transport when these are unset.
# `SENTRY_DSN` is server-side, `NEXT_PUBLIC_*` is exposed to the browser.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Supabase Auth (BRIEF §5: phone OTP primary, email secondary). Both are
# safe to expose to the browser — the anon key is a public RLS-bound
# identifier, not a secret. Leave empty in development to use the
# cookie-backed stub session (any +966 phone, any 6-digit OTP). When
# both are set the sign-in flow switches to real SMS OTP — no code change.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated E.164 phones that can access /admin. Server-only.
# Example: ADMIN_PHONES=+966512345678,+966599999999
# Empty → /admin returns 404 for everyone.
ADMIN_PHONES=
